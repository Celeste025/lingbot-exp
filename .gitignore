*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
env/
envs/
data/
outputs/
checkpoints/
wandb/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.tar
*.tar.gz
*.zip
*.log
.env
.env.*
**/*token*
!experiment_artifacts/**/*.json
!experiment_artifacts/**/*.jsonl
!experiment_artifacts/**/*.txt
!experiment_artifacts/**/*.log
